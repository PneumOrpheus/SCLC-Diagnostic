# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Environments
venv/
.venv/
anaconda3/

# Model weights and large local data
*.pth
NIFTI_data/

# Training artifacts (raw outputs, run logs, archived results)
results/output/
results/runs/
results/thesis/_archive/

# Per-run training logs in the final-CV output trees (verbose stdout dumps;
# metrics.jsonl + inference JSONs are the canonical artefacts)
results/output_master_base/**/*_logs.txt
results/output_master_fpn/**/*_logs.txt

# Per-config build artefacts (regenerated by scripts/build_final_results.py
# from the union-of-folds inference JSONs)
results/thesis_final/per_config/

# Notebook-generated figures and caches
data_pipeline/notebooks/output/
# Regenerable visualization outputs (built from checkpoints by sclc.grad_cam)
results/grad_cam/

# Ad-hoc reference uploads at repo root (uploaded papers, dataset manifests, etc.).
# Root-anchored so the tracked thesis PDFs under results/figures/ stay tracked.
/*.pdf
/*.xlsx

# Internal-only docs
CLAUDE.md
.claude/
